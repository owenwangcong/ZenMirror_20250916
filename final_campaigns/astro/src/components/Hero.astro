---
import { Icon } from 'astro-icon/components';
---

<section class="hero-section relative overflow-hidden bg-white section-padding">
  <!-- Animated background with subtle pattern -->
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="radar-animation"></div>
  </div>

  <!-- Subtle gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-zen-forest-ultra via-transparent to-zen-orange-pale opacity-40"></div>

  <div class="container-custom relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left column: Content -->
      <div class="space-y-8 animate-fade-in">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-zen-forest-dark to-zen-forest-medium text-white rounded-full text-sm font-semibold shadow-lg">
          <span>🚀</span>
          <span>LIVE ON KICKSTARTER</span>
        </div>

        <!-- Title -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-zen-charcoal">
          See Your Calm. Master Your Mind.<br>
          <span class="text-zen-forest-dark">Transform Your Meditation.</span>
        </h1>

        <!-- Who It's For -->
        <div class="inline-flex items-center gap-2 bg-zen-gray-ultra border-2 border-zen-gray-light px-4 py-2 rounded-full text-sm">
          <span class="text-zen-gray-darker">For meditators who want to know:</span>
          <span class="font-semibold text-zen-forest-dark">"Am I actually doing this right?"</span>
        </div>

        <!-- Subtitle -->
        <p class="text-lg md:text-xl text-zen-gray-darker leading-relaxed max-w-2xl">
          The world's first contactless meditation biofeedback device that monitors your heart, breath, and stillness in real-time, alerting you when disturbances appear so you can course-correct—using advanced millimeter wave radar with no sensors on your body.
        </p>

        <!-- Features list -->
        <div class="grid grid-cols-2 gap-3 text-sm md:text-base text-zen-gray-darker">
          <div class="flex items-center gap-2">
            <Icon name="heroicons:check-circle-solid" class="w-5 h-5 text-zen-forest-medium flex-shrink-0" />
            <span>Completely Contactless</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="heroicons:check-circle-solid" class="w-5 h-5 text-zen-forest-medium flex-shrink-0" />
            <span>Real-Time HRV Feedback</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="heroicons:check-circle-solid" class="w-5 h-5 text-zen-forest-medium flex-shrink-0" />
            <span>Meditation Quality Score</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="heroicons:check-circle-solid" class="w-5 h-5 text-zen-forest-medium flex-shrink-0" />
            <span>6 Wisdom Mentors</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="heroicons:check-circle-solid" class="w-5 h-5 text-zen-forest-medium flex-shrink-0" />
            <span>FREE Lifetime Premium</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="heroicons:check-circle-solid" class="w-5 h-5 text-zen-forest-medium flex-shrink-0" />
            <span>Privacy Protected</span>
          </div>
        </div>

        <!-- CTA Button -->
        <div class="space-y-4">
          <a href="#rewards" class="btn-primary inline-flex items-center gap-2 text-lg">
            Back This Project - $129 Early Bird
            <Icon name="heroicons:arrow-right" class="w-5 h-5" />
          </a>
          <div class="flex items-center gap-4 text-sm text-zen-gray-darker">
            <p>🔥 <strong class="text-zen-orange-accent">$129</strong> Super Early Bird (60% off)</p>
            <p>💎 FREE Lifetime Premium for backers</p>
          </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 pt-8 border-t border-zen-gray-light">
          <div>
            <div class="text-2xl md:text-3xl font-bold text-zen-charcoal">$247K</div>
            <div class="text-sm text-zen-gray-dark">raised</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-bold text-zen-charcoal">1,234</div>
            <div class="text-sm text-zen-gray-dark">backers</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-bold text-zen-charcoal">18 days</div>
            <div class="text-sm text-zen-gray-dark">to go</div>
          </div>
        </div>
      </div>

      <!-- Right column: Product showcase -->
      <div class="relative animate-fade-in" style="animation-delay: 0.2s;">
        <div class="relative z-10">
          <!-- Product image -->
          <div class="aspect-square rounded-3xl overflow-hidden shadow-2xl border-2 border-zen-gray-light">
            <img
              src="/assets/images/lifestyle/bedroom-nightstand.png"
              alt="ZenMirror meditation device on bedside table in peaceful bedroom setting"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>

          <!-- Floating data card -->
          <div class="absolute -bottom-6 -right-6 bg-white text-zen-charcoal rounded-2xl p-6 shadow-2xl border-2 border-zen-forest-pale max-w-xs">
            <h4 class="font-semibold mb-3 text-zen-forest-dark">Live Monitoring</h4>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between items-center">
                <span class="text-zen-gray-dark">Heart Rate</span>
                <span class="font-bold text-zen-forest-medium">68 BPM</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-zen-gray-dark">Breath Rate</span>
                <span class="font-bold text-zen-forest-medium">6/min</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-zen-gray-dark">HRV Score</span>
                <span class="font-bold text-green-600">89</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Radar waves animation -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div class="radar-wave"></div>
          <div class="radar-wave" style="animation-delay: 1s;"></div>
          <div class="radar-wave" style="animation-delay: 2s;"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes radar {
    0% {
      transform: scale(0);
      opacity: 1;
    }
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .radar-wave {
    position: absolute;
    width: 100px;
    height: 100px;
    border: 2px solid rgba(45, 91, 62, 0.3);
    border-radius: 50%;
    animation: radar 3s ease-out infinite;
  }

  .radar-animation {
    width: 100%;
    height: 100%;
    background-image: radial-gradient(circle, rgba(45, 91, 62, 0.1) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: radar-bg 20s linear infinite;
  }

  @keyframes radar-bg {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(50px);
    }
  }
</style>
