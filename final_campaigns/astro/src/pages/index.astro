---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import HRVChart from '../components/charts/HRVChart.astro';
import SessionQualityChart from '../components/charts/SessionQualityChart.astro';
import RadarComparison from '../components/charts/RadarComparison.astro';
import ComparisonMatrix from '../components/ComparisonMatrix.astro';
import '../styles/global.css';
---

<BaseLayout>
  <!-- Hero Section -->
  <Hero />

  <!-- Video Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="relative aspect-video rounded-3xl overflow-hidden shadow-2xl border-2 border-zen-gray-light group">
          <!-- Video Element -->
          <video
            id="campaign-video"
            class="w-full h-full object-cover"
            preload="metadata"
            poster="/assets/images/lifestyle/night-bedside-lotus.png"
          >
            <source src="/assets/videos/campaign.mp4" type="video/mp4" />
            Your browser does not support the video tag.
          </video>

          <!-- Play Button Overlay -->
          <div id="video-overlay" class="absolute inset-0 flex items-center justify-center bg-white/95 cursor-pointer transition-opacity duration-300">
            <button class="w-20 h-20 bg-zen-forest-dark rounded-full flex items-center justify-center shadow-xl transform group-hover:scale-110 transition-transform duration-300">
              <Icon name="heroicons:play-solid" class="w-10 h-10 text-white ml-1" />
            </button>
          </div>

          <!-- Video Info Overlay -->
          <div id="video-info" class="absolute bottom-0 left-0 right-0 p-8 bg-gradient-to-t from-black/60 to-transparent pointer-events-none">
            <h3 class="text-2xl font-semibold text-white mb-2">See ZenMirror in Action</h3>
            <p class="text-white/90">Watch how contactless radar technology revolutionizes meditation practice</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const video = document.getElementById('campaign-video') as HTMLVideoElement;
    const overlay = document.getElementById('video-overlay');
    const videoInfo = document.getElementById('video-info');

    if (video && overlay && videoInfo) {
      // Play video when overlay is clicked
      overlay.addEventListener('click', () => {
        video.play();
        overlay.style.opacity = '0';
        videoInfo.style.opacity = '0';
        setTimeout(() => {
          overlay.style.display = 'none';
          videoInfo.style.display = 'none';
        }, 300);
        video.setAttribute('controls', 'true');
      });

      // Show overlay when video ends
      video.addEventListener('ended', () => {
        overlay.style.display = 'flex';
        videoInfo.style.display = 'block';
        setTimeout(() => {
          overlay.style.opacity = '1';
          videoInfo.style.opacity = '1';
        }, 10);
        video.removeAttribute('controls');
      });
    }
  </script>

  <!-- Mom Test Introduction Section -->
  <section class="py-16 md:py-24 bg-white relative overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-[0.02]">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle, #2C5F4F 1px, transparent 1px); background-size: 40px 40px;"></div>
    </div>

    <div class="container-custom relative z-10">
      <!-- Main Question with Social Proof -->
      <div class="text-center mb-4">
        <!-- Backer Count Badge -->
        <div class="inline-flex items-center gap-2 bg-zen-orange-accent/10 px-4 py-2 rounded-full mb-4">
          <div class="flex -space-x-2">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 border-2 border-white"></div>
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-green-400 to-green-600 border-2 border-white"></div>
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-400 to-purple-600 border-2 border-white"></div>
          </div>
          <span class="text-sm font-semibold text-zen-forest-medium">1,234 backers already transforming their practice</span>
        </div>

        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-zen-forest-dark mb-4">
          Finally Know If Your Meditation<br>Is <span class="bg-gradient-to-r from-zen-orange-accent to-zen-orange-warm bg-clip-text text-transparent">Actually Working</span>
        </h2>
        <p class="text-xl md:text-2xl text-zen-gray-dark max-w-3xl mx-auto mb-8">
          The world's first contactless meditation biofeedback system that shows you—in real-time—when you're calm and when you're not. No guesswork. Just results.
        </p>

        <!-- Success Metrics Grid -->
        <div class="flex flex-wrap justify-center gap-4 max-w-4xl mx-auto">
          <div class="bg-gradient-to-br from-green-50 to-emerald-50 border-2 border-green-400 px-5 py-3 rounded-xl">
            <div class="text-2xl font-bold text-green-700">Most Users</div>
            <div class="text-xs font-semibold text-green-600">See results quickly</div>
          </div>
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 border-2 border-blue-400 px-5 py-3 rounded-xl">
            <div class="text-2xl font-bold text-blue-700">Significant</div>
            <div class="text-xs font-semibold text-blue-600">Coherence improvements</div>
          </div>
          <div class="bg-gradient-to-br from-purple-50 to-violet-50 border-2 border-purple-400 px-5 py-3 rounded-xl">
            <div class="text-2xl font-bold text-purple-700">Dramatically</div>
            <div class="text-xs font-semibold text-purple-600">Faster progress</div>
          </div>
        </div>
      </div>

      <!-- The 4 Mom Test Answers -->
      <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-8 mb-12">
        <!-- 1. What Does It Do? -->
        <div class="bg-white rounded-2xl p-8 shadow-zen-lg border-2 border-zen-forest-medium hover:shadow-zen-glow transition-all duration-300 group">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-zen-forest-medium to-zen-forest-dark flex items-center justify-center text-white font-bold text-2xl flex-shrink-0 group-hover:scale-110 transition-transform">
              📡
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-bold text-zen-forest-medium/50">WHAT IT DOES</span>
              </div>
              <h3 class="text-2xl font-bold text-zen-forest-medium mb-3">Your Meditation Radar</h3>
              <p class="text-base text-zen-gray-dark leading-relaxed mb-4">
                Invisible radar monitors your heart & breath <strong>without touching you</strong>. Get instant alerts when stress creeps in.
              </p>
            </div>
          </div>

          <div class="bg-gradient-to-r from-zen-bamboo/20 to-white rounded-xl p-4 border-l-4 border-zen-forest-medium">
            <p class="text-sm text-zen-gray-dark mb-3">
              <strong class="text-zen-forest-medium">Like a mirror for stress:</strong> You can't see your own heart rate spike—but ZenMirror can, alerting you in seconds.
            </p>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <div class="flex items-center gap-1 text-zen-forest-medium font-semibold">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                <span>10s updates</span>
              </div>
              <div class="text-zen-gray-dark">
                <span class="font-bold text-zen-orange-accent">vs 60s</span> apps
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Who Is It For? -->
        <div class="bg-white rounded-2xl p-8 shadow-zen-lg border-2 border-zen-orange-accent hover:shadow-zen-glow transition-all duration-300 group">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-zen-orange-accent to-zen-orange-warm flex items-center justify-center text-white font-bold text-2xl flex-shrink-0 group-hover:scale-110 transition-transform">
              🎯
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-bold text-zen-orange-accent/50">WHO IT'S FOR</span>
              </div>
              <h3 class="text-2xl font-bold text-zen-forest-medium mb-3">Built For Skeptics</h3>
              <p class="text-base text-zen-gray-dark leading-relaxed mb-4">
                If you've ever wondered <strong>"Is this actually working?"</strong> while meditating—this is for you.
              </p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 mb-4">
            <div class="bg-orange-50 rounded-lg p-3 border border-orange-200">
              <div class="font-bold text-zen-orange-accent text-lg">Most Users</div>
              <div class="text-xs text-zen-gray-dark mt-1">New to meditation</div>
              <div class="text-xs font-semibold text-green-600 mt-1">Substantial progress</div>
            </div>
            <div class="bg-orange-50 rounded-lg p-3 border border-orange-200">
              <div class="font-bold text-zen-orange-accent text-lg">Many Users</div>
              <div class="text-xs text-zen-gray-dark mt-1">Experienced practitioners</div>
              <div class="text-xs font-semibold text-green-600 mt-1">Breakthrough insights</div>
            </div>
          </div>

          <div class="bg-zen-orange-accent/5 rounded-lg p-3 text-xs text-zen-gray-dark italic border-l-4 border-zen-orange-accent">
            "I've meditated for 5 years but always wondered if I was doing it right. Week 1 with ZenMirror: mind = blown."
            <div class="font-semibold text-zen-forest-medium mt-1">- Lisa M., Beta Tester</div>
          </div>
        </div>

        <!-- 3. Why Is It Better? -->
        <div class="bg-white rounded-2xl p-8 shadow-zen-lg border-2 border-purple-400 hover:shadow-zen-glow transition-all duration-300 group">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-purple-600 to-indigo-600 flex items-center justify-center text-white font-bold text-2xl flex-shrink-0 group-hover:scale-110 transition-transform">
              ⚡
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-bold text-purple-600/50">WHY IT WINS</span>
              </div>
              <h3 class="text-2xl font-bold text-zen-forest-medium mb-3">Crushes Competitors</h3>
              <p class="text-base text-zen-gray-dark leading-relaxed mb-4">
                More comfortable than headbands, smart watches, chest straps, and other wearables. More accurate than apps. <strong>Half the price</strong> of Muse ($350).
              </p>
            </div>
          </div>

          <!-- Quick Comparison -->
          <div class="bg-gradient-to-r from-purple-50 to-indigo-50 rounded-xl p-4 mb-3 border border-purple-200">
            <div class="grid grid-cols-3 gap-2 text-center text-xs mb-3">
              <div>
                <div class="font-bold text-purple-700 mb-1">$129</div>
                <div class="text-zen-gray-dark">ZenMirror</div>
              </div>
              <div class="opacity-50">
                <div class="font-bold text-zen-gray-dark mb-1 line-through">$350</div>
                <div class="text-zen-gray-dark">Muse</div>
              </div>
              <div class="opacity-50">
                <div class="font-bold text-zen-gray-dark mb-1 line-through">$399</div>
                <div class="text-zen-gray-dark">Apple Watch</div>
              </div>
            </div>
            <div class="text-center bg-green-500/10 rounded-lg py-2 border border-green-500/20">
              <div class="text-xs font-bold text-green-700">
                Exceptional value + FREE Lifetime Premium included
              </div>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-2 text-xs">
            <div class="flex items-center gap-1 text-green-600 font-semibold">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>No wearables</span>
            </div>
            <div class="flex items-center gap-1 text-green-600 font-semibold">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>FREE Premium</span>
            </div>
            <div class="flex items-center gap-1 text-green-600 font-semibold">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>10sec updates</span>
            </div>
            <div class="flex items-center gap-1 text-green-600 font-semibold">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              <span>0-100 score</span>
            </div>
          </div>
        </div>

        <!-- 4. What Data & Feedback? -->
        <div class="bg-white rounded-2xl p-8 shadow-zen-lg border-2 border-blue-500 hover:shadow-zen-glow transition-all duration-300 group">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-2xl flex-shrink-0 group-hover:scale-110 transition-transform">
              📊
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-bold text-blue-600/50">THE DATA</span>
              </div>
              <h3 class="text-2xl font-bold text-zen-forest-medium mb-3">Real Science, Not Fake Praise</h3>
              <p class="text-base text-zen-gray-dark leading-relaxed mb-4">
                <strong>14 biometric markers</strong> apps can't measure. Honest feedback—even when it stings.
              </p>
            </div>
          </div>

          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-4 mb-3 border border-blue-200">
            <div class="grid grid-cols-2 gap-3 mb-3">
              <div class="text-center bg-white/50 rounded-lg p-2">
                <div class="text-2xl font-bold text-blue-600">0-100</div>
                <div class="text-xs text-zen-gray-dark">Coherence Score</div>
              </div>
              <div class="text-center bg-white/50 rounded-lg p-2">
                <div class="text-2xl font-bold text-purple-600">10s</div>
                <div class="text-xs text-zen-gray-dark">Update Speed</div>
              </div>
            </div>
            <div class="bg-white/70 rounded-lg p-2 border-l-4 border-blue-500">
              <div class="text-xs font-semibold text-zen-gray-dark mb-1">Real User Experience:</div>
              <div class="text-xs text-zen-gray-dark italic">
                "Noticed significant improvement within minutes of first alert. Score climbed noticeably throughout session."
              </div>
            </div>
          </div>

          <div class="flex items-center gap-2 text-xs">
            <span class="bg-blue-100 text-blue-700 px-2 py-1 rounded">HRV</span>
            <span class="bg-purple-100 text-purple-700 px-2 py-1 rounded">RSA</span>
            <span class="bg-green-100 text-green-700 px-2 py-1 rounded">6 AI Mentors</span>
          </div>
        </div>
      </div>

      <!-- Transformation Visual - Enhanced -->
      <div class="max-w-6xl mx-auto mb-12">
        <h3 class="text-3xl font-bold text-zen-forest-medium mb-2 text-center">
          Your Meditation Transformation
        </h3>
        <p class="text-center text-zen-gray-dark mb-8">Watch your progress unfold with data-driven certainty</p>
        <div class="grid md:grid-cols-3 gap-6">
          <!-- Before -->
          <div class="bg-gradient-to-br from-red-50 to-orange-50 rounded-2xl p-8 text-center border-2 border-red-200 relative">
            <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-red-500 text-white px-3 py-1 rounded-full text-xs font-bold">
              STARTING POINT
            </div>
            <div class="text-6xl mb-4">😰</div>
            <h4 class="text-xl font-bold text-red-700 mb-3">Before ZenMirror</h4>
            <ul class="text-left space-y-2 text-sm text-zen-gray-dark">
              <li class="flex items-start gap-2">
                <span class="text-red-500">✗</span>
                <span>Constant doubt: "Am I doing this right?"</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-red-500">✗</span>
                <span>No way to track progress</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-red-500">✗</span>
                <span>Mind wanders, no feedback</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-red-500">✗</span>
                <span>Motivation fades quickly</span>
              </li>
            </ul>
          </div>

          <!-- During -->
          <div class="bg-gradient-to-br from-zen-forest-medium to-zen-forest-dark rounded-2xl p-8 text-center text-white shadow-zen-glow relative">
            <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-zen-orange-accent px-4 py-1 rounded-full text-sm font-bold shadow-lg">
              FIRST WEEK
            </div>
            <div class="text-6xl mb-4">📡</div>
            <h4 class="text-xl font-bold mb-3">With ZenMirror</h4>
            <div class="space-y-3 text-sm">
              <div class="bg-white/10 backdrop-blur-sm rounded-lg p-3">
                <div class="font-bold mb-1">Real-Time Alerts</div>
                <div class="text-white/80">Know instantly when stress appears</div>
              </div>
              <div class="bg-white/10 backdrop-blur-sm rounded-lg p-3">
                <div class="font-bold mb-1">0-100 Score</div>
                <div class="text-white/80">Objective progress tracking</div>
              </div>
              <div class="bg-white/10 backdrop-blur-sm rounded-lg p-3">
                <div class="font-bold mb-1">6 AI Mentors</div>
                <div class="text-white/80">Personalized guidance</div>
              </div>
            </div>
          </div>

          <!-- After -->
          <div class="bg-gradient-to-br from-green-50 to-teal-50 rounded-2xl p-8 text-center border-2 border-green-500 relative">
            <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-green-600 text-white px-3 py-1 rounded-full text-xs font-bold">
              ONE MONTH LATER
            </div>
            <div class="text-6xl mb-4">😌</div>
            <h4 class="text-xl font-bold text-green-700 mb-3">Your Results</h4>
            <ul class="text-left space-y-2 text-sm text-zen-gray-dark">
              <li class="flex items-start gap-2">
                <span class="text-green-600 text-lg">✓</span>
                <span><strong class="text-green-700">Substantial</strong> coherence improvement</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-600 text-lg">✓</span>
                <span>Mind-wandering detected <strong class="text-green-700">rapidly</strong></span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-600 text-lg">✓</span>
                <span><strong class="text-green-700">Consistent daily practice</strong> established</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-600 text-lg">✓</span>
                <span><strong class="text-green-700">Significant HRV gains</strong> measured</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Urgency CTA Section -->
      <div class="max-w-5xl mx-auto bg-gradient-to-br from-zen-forest-dark to-zen-forest-medium rounded-3xl p-8 md:p-12 text-center text-white shadow-2xl border-2 border-zen-forest-dark relative overflow-hidden">
        <!-- Animated background -->
        <div class="absolute inset-0 opacity-5">
          <div class="absolute inset-0" style="background-image: radial-gradient(circle, white 2px, transparent 2px); background-size: 30px 30px;"></div>
        </div>

        <div class="relative z-10">
          <!-- Scarcity Badge -->
          <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full mb-4 animate-pulse">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
            </svg>
            <span class="font-bold text-sm">Only 23 of 100 Super Early Bird spots left!</span>
          </div>

          <h3 class="text-3xl md:text-4xl font-bold mb-4">
            Start Your Transformation at $129
          </h3>
          <p class="text-xl md:text-2xl mb-6 text-white/90">
            Join 1,234 backers getting <strong>FREE Lifetime Premium</strong><br>
            <span class="text-lg">(Future price: $9.99/month = Save $120/year)</span>
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-6">
            <a href="#rewards" class="inline-flex items-center gap-2 bg-white text-zen-orange-accent font-bold px-8 py-4 rounded-xl text-lg hover:bg-white transition-all duration-300 shadow-xl hover:scale-105">
              <span>Claim Your Spot - $129</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
            <span class="text-sm text-white/80">Ships June 2025 • 2-Year Warranty</span>
          </div>

          <!-- Risk Reversal Badge -->
          <div class="mb-4 inline-block bg-white/20 backdrop-blur-sm px-6 py-3 rounded-2xl border-2 border-white/30">
            <div class="flex items-center gap-3">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <div class="text-left">
                <div class="font-bold text-lg">Zero Risk Guarantee</div>
                <div class="text-sm text-white/90">Full refund if not satisfied - We deliver or you don't pay</div>
              </div>
            </div>
          </div>

          <!-- Trust Badges -->
